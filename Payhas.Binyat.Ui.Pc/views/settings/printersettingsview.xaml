<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Settings.PrinterSettingsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Settings;assembly=Payhas.Binyat.Ui.Core">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal"
                dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button Margin="0,0,10,0" IsDefault="true" Content="{Localize Save}" Command="{Binding SaveCommand}"/>
      <Button IsCancel="true" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
    </StackPanel>
    <Grid FocusManager.FocusedElement="{Binding ElementName=FirstFocus}">
      <dxlc:LayoutControl Width="400" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutGroup Orientation="Vertical">
          <dxlc:LayoutItem Label="{Localize StandardPrinter}">
            <dxe:ComboBoxEdit ValueMember="Value" DisplayMember="Text" NullValueButtonPlacement="EditBox"
                              EditValue="{Binding Config.StandardPrinterName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Printers}"/>
          </dxlc:LayoutItem>
          <dxlc:LayoutItem Label="{Localize ChequePrinter}">
            <dxe:ComboBoxEdit ValueMember="Value" DisplayMember="Text" NullValueButtonPlacement="EditBox"
                              EditValue="{Binding Config.ChequePrinterName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Printers}"/>
          </dxlc:LayoutItem>
          <dxlc:LayoutItem Label="{Localize BarcodePrinter}">
            <dxe:ComboBoxEdit ValueMember="Value" DisplayMember="Text" NullValueButtonPlacement="EditBox"
                              EditValue="{Binding Config.BarcodePrinterName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Printers}"/>
          </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>