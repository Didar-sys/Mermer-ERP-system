<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Settings.MockObjectsView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Settings;assembly=Payhas.Binyat.Ui.Core">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal"
                dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button IsCancel="true" Content="{Localize Close}" Command="{Binding CloseCommand}"/>
    </StackPanel>
    <Grid>
      <dxlc:LayoutControl Width="500" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutGroup View="Tabs">
          <dxlc:LayoutGroup Orientation="Vertical" Width="350" Header="{Localize Commerce}">
            <dxlc:LayoutItem Label="{Localize 'Invoices Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateInvoicesCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateInvoices}"
                    Content="{Localize 'Create Mock Invoices'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'Bills Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateBillsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateBills}"
                    Content="{Localize 'Create Mock Bills'}"/>
          </dxlc:LayoutGroup>
          <dxlc:LayoutGroup Orientation="Vertical" Width="350" Header="{Localize Warehousing}">
            <dxlc:LayoutItem Label="{Localize 'Stocks Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateStocksCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateStocks}"
                    Content="{Localize 'Create Mock Stocks'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'StockSlips Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateStockSlipsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateStockSlips}"
                    Content="{Localize 'Create Mock StockSlips'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'StockTransfers Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateStockTransfersCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateStockTransfers}"
                    Content="{Localize 'Create Mock StockTransfers'}"/>
          </dxlc:LayoutGroup>
          <dxlc:LayoutGroup Orientation="Vertical" Width="350" Header="{Localize Finance}">
            <dxlc:LayoutItem Label="{Localize 'Expenses Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateExpensesCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateExpenses}"
                    Content="{Localize 'Create Mock Expenses'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'ExpenseSlips Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateExpenseSlipsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateExpenseSlips}"
                    Content="{Localize 'Create Mock ExpenseSlips'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'FundsSlips Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateFundsSlipsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateFundsSlips}"
                    Content="{Localize 'Create Mock FundsSlips'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'FundsTransfers Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreateFundsTransfersCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreateFundsTransfers}"
                    Content="{Localize 'Create Mock FundsTransfers'}"/>
          </dxlc:LayoutGroup>
          <dxlc:LayoutGroup Orientation="Vertical" Width="350" Header="{Localize CRM}">
            <dxlc:LayoutItem Label="{Localize 'Partners Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreatePartnersCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreatePartners}"
                    Content="{Localize 'Create Mock Partners'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'PartnerSlips Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreatePartnerSlipsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreatePartnerSlips}"
                    Content="{Localize 'Create Mock PartnerSlips'}"/>
            <dxlc:LayoutItem Height="10"/>
            <dxlc:LayoutItem Label="{Localize 'PartnerTransfers Count to Create'}">
              <dxe:SpinEdit MinValue="0" IsFloatValue="false" EditValueType="{x:Type sys:Int32}"
                            EditValue="{Binding CreatePartnerTransfersCount, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <Button HorizontalAlignment="Right" Height="30" Command="{Binding CreatePartnerTransfers}"
                    Content="{Localize 'Create Mock PartnerTransfers'}"/>
          </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
        <dxlc:LayoutItem Height="10"/>
        <Label VerticalAlignment="Top" Content="{Binding Status}"/>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>