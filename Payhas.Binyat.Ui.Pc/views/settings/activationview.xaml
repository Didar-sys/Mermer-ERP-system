<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Settings.ActivationView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Settings;assembly=Payhas.Binyat.Ui.Core"
                xmlns:controls="clr-namespace:Payhas.Binyat.Ui.Pc.Controls"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                Loaded="ActivationView_OnLoaded">
  <DockPanel>
    <Grid FocusManager.FocusedElement="{Binding ElementName=FirstFocus}">
      <dxlc:LayoutControl Width="500" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutGroup View="Tabs">
          <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Client License Info'}">
            <dxlc:LayoutGroup Visibility="{Binding ClientActivationStatus.IsActive, Converter={dx:BooleanToVisibilityConverter}}">
              <TextBlock FontSize="24" Foreground="Green" Text="{Localize 'Client is activated'}"/>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Visibility="{Binding ClientActivationStatus.IsActive, Converter={dx:BooleanToVisibilityConverter Invert=true}}">
              <TextBlock FontSize="24" Foreground="DarkRed" Text="{Localize 'Client is NOT activated'}"/>
            </dxlc:LayoutGroup>
            <dxg:GridControl Height="150" ItemsSource="{Binding ClientActivationStatus.ActiveDates}">
              <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="DateValidFrom" Header="{Localize DateActiveFrom}"/>
                <dxg:GridColumn FieldName="DateValidTill" Header="{Localize DateActiveTill}"/>
              </dxg:GridControl.Columns>
              <dxg:GridControl.View>
                <dxg:TableView ShowSearchPanelMode="Never" NewItemRowPosition="None" ShowGroupPanel="false" AllowEditing="false"
                               AutoWidth="true"/>
              </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutItem Height="5"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
              <Button Margin="0,0,10,0" Content="{Localize 'Update Status'}"
                      Command="{Binding UpdateClientStatusCommand}"/>
              <Button Margin="0,0,10,0" Content="{Localize Reactivate}" Command="{Binding ReactivateClientCommand}"/>
              <Button Content="{Localize Deactivate}" Command="{Binding DeactivateClientCommand}"/>
            </StackPanel>
            <dxlc:LayoutItem Height="15"/>
            <dxlc:LayoutItem Label="{Localize 'License Id'}">
              <dxe:TextEdit EditValue="{Binding ClientLicenseId, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="{Localize Note}">
              <dxe:TextEdit x:Name="ClientNote" EditValue="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
              <Button Margin="0,0,10,0" Content="{Localize 'Activate Client'}" Command="{Binding ActivateClientCommand}"/>
              <Button IsCancel="true" Content="{Localize Close}" Command="{Binding CloseCommand}"/>
            </StackPanel>
          </dxlc:LayoutGroup>
          <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Server License Info'}">
            <dxlc:LayoutGroup Visibility="{Binding ServerActivationStatus.IsActive, Converter={dx:BooleanToVisibilityConverter}}">
              <TextBlock FontSize="24" Foreground="Green" Text="{Localize 'Server is activated'}"/>
            </dxlc:LayoutGroup>
            <dxlc:LayoutGroup Visibility="{Binding ServerActivationStatus.IsActive, Converter={dx:BooleanToVisibilityConverter Invert=true}}">
              <TextBlock FontSize="24" Foreground="DarkRed" Text="{Localize 'Server is NOT activated'}"/>
            </dxlc:LayoutGroup>
            <dxg:GridControl Height="150" ItemsSource="{Binding ServerActivationStatus.ActiveDates}">
              <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="DateValidFrom" Header="{Localize DateActiveFrom}"/>
                <dxg:GridColumn FieldName="DateValidTill" Header="{Localize DateActiveTill}"/>
              </dxg:GridControl.Columns>
              <dxg:GridControl.View>
                <dxg:TableView ShowSearchPanelMode="Never" NewItemRowPosition="None" ShowGroupPanel="false" AllowEditing="false"
                               AutoWidth="true"/>
              </dxg:GridControl.View>
            </dxg:GridControl>
            <dxlc:LayoutItem Height="5"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
              <Button Margin="0,0,10,0" Content="{Localize 'Update Status'}"
                      Command="{Binding UpdateServerStatusCommand}"/>
              <Button Margin="0,0,10,0" Content="{Localize Reactivate}" Command="{Binding ReactivateServerCommand}"/>
              <Button Content="{Localize Deactivate}" Command="{Binding DeactivateServerCommand}"/>
            </StackPanel>
            <dxlc:LayoutItem Height="15"/>
            <dxlc:LayoutItem Label="{Localize 'License Id'}">
              <dxe:TextEdit EditValue="{Binding ServerLicenseId, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem Label="{Localize Note}">
              <dxe:TextEdit x:Name="ServerNote" EditValue="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
            </dxlc:LayoutItem>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
              <Button Margin="0,0,10,0" Content="{Localize 'Activate Server'}" Command="{Binding ActivateServerCommand}"/>
              <Button IsCancel="true" Content="{Localize Close}" Command="{Binding CloseCommand}"/>
            </StackPanel>
          </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>