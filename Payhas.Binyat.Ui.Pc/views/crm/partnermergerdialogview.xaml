<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.CRM.PartnerMergerDialogView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.CRM;assembly=Payhas.Binyat.Ui.Core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:ctrl="clr-namespace:Payhas.Binyat.Ui.Pc.Controls">
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button HorizontalAlignment="Left" Content="{Localize 'Delete Selected'}"
              Command="{Binding SelectedItemsDeleteCommand}"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Content="{Localize Merge}" Command="{Binding MergeCommand}"/>
        <Button Margin="10,0,0,0" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
      </StackPanel>
    </Grid>
    <dxlc:LayoutControl Orientation="Vertical" IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
      <dxlc:LayoutGroup VerticalAlignment="Top">
        <dxe:CheckEdit HorizontalAlignment="Right" VerticalAlignment="Top"
                       EditValue="{Binding DisableMergedItems, UpdateSourceTrigger=PropertyChanged}"
                       Content="{Localize 'Disable Merged Items'}"/>
      </dxlc:LayoutGroup>
      <dxg:GridControl SelectionMode="MultipleRow" MinHeight="300" MaxWidth="700" ItemsSource="{Binding List}"
                       ShowLoadingPanel="{Binding IsBusy}">
        <dxg:DataControlBase.SelectedItems>
          <Binding>            <!-- constructor argument:
                 SelectedItems
            -->

          </Binding>
        </dxg:DataControlBase.SelectedItems>
        <dxg:GridColumn FieldName="IsMain" Width="50" Header="{Localize Main}"/>
        <dxg:GridColumn FieldName="PartnerId" Header="{Localize Code}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Code" ValueMember="Id"
                                    ItemsSource="{Binding Partners.List}">
              <dxe:PopupBaseEditSettings.PopupContentTemplate>
                <ControlTemplate>
                  <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                    <dxg:GridControl.Columns>
                      <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
                      <dxg:GridColumn FieldName="Name" Width="300" Header="{Localize Name}"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                      <dxg:TableView AutoWidth="true"/>
                    </dxg:GridControl.View>
                  </dxg:GridControl>
                </ControlTemplate>
              </dxe:PopupBaseEditSettings.PopupContentTemplate>
              <dxe:BaseEditSettings.StyleSettings>
                <dxg:SearchLookUpEditStyleSettings/>
              </dxe:BaseEditSettings.StyleSettings>
            </dxg:LookUpEditSettings>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="PartnerId" Width="500" Header="{Localize Name}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                                    ItemsSource="{Binding Partners.List}">
              <dxe:PopupBaseEditSettings.PopupContentTemplate>
                <ControlTemplate>
                  <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                    <dxg:GridControl.Columns>
                      <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
                      <dxg:GridColumn FieldName="Name" Width="300" Header="{Localize Name}"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                      <dxg:TableView AutoWidth="true"/>
                    </dxg:GridControl.View>
                  </dxg:GridControl>
                </ControlTemplate>
              </dxe:PopupBaseEditSettings.PopupContentTemplate>
              <dxe:BaseEditSettings.StyleSettings>
                <dxg:SearchLookUpEditStyleSettings/>
              </dxe:BaseEditSettings.StyleSettings>
            </dxg:LookUpEditSettings>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridControl.View>
          <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="Bottom" AllowPerPixelScrolling="true"
                         EnableImmediatePosting="true" ShowCheckBoxSelectorColumn="true"
                         ShowCheckBoxSelectorInGroupRow="true" RetainSelectionOnClickOutsideCheckBoxSelector="true"/>
        </dxg:GridControl.View>
      </dxg:GridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>