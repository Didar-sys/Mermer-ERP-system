<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Warehousing.Revisioning.StockRevisionDetailsReportView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Payhas.Binyat.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Payhas.Binyat.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Payhas.Binyat.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Warehousing.Revisioning;assembly=Payhas.Binyat.Ui.Core">
  <FrameworkElement.Resources>
    <Style x:Key="FilterCount" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="36"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
      <Setter Property="FrameworkElement.VerticalAlignment" Value="Top"/>
      <Setter Property="FrameworkElement.Margin" Value="0,-5,8,0"/>
      <Setter Property="UIElement.Opacity" Value="0.6"/>
    </Style>
    <Style x:Key="FilterText" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="16"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Left"/>
      <Setter Property="FrameworkElement.VerticalAlignment" Value="Bottom"/>
      <Setter Property="FrameworkElement.Margin" Value="6,0,0,3"/>
    </Style>
    <Style x:Key="FilterInitials" TargetType="{x:Type TextBlock}">
      <Setter Property="FrameworkElement.Height" Value="80"/>
      <Setter Property="TextBlock.FontSize" Value="75"/>
      <Setter Property="UIElement.Opacity" Value="0.2"/>
      <Setter Property="FrameworkElement.Margin" Value="6,0,0,0"/>
      <Setter Property="FrameworkElement.VerticalAlignment" Value="Top"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Left"/>
      <Setter Property="FrameworkElement.LayoutTransform">
        <Setter.Value>
          <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform Angle="180"/>
            <TranslateTransform/>
          </TransformGroup>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Resources>
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <Grid DockPanel.Dock="Left"
          Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <dxnav:TileBar Style="{StaticResource FilterStyle}">
        <dxnav:TileBarItem Click="ExceedsClick">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Style="{StaticResource FilterCount}"
                           Text="{Binding DataContext.ExceedsCount, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource FilterText}" Text="{Localize Exceeds}"/>
                <TextBlock Text="+" Style="{StaticResource FilterInitials}">
                  <FrameworkElement.LayoutTransform>
                    <TransformGroup>
                      <ScaleTransform/>
                      <SkewTransform/>
                      <RotateTransform Angle="180"/>
                      <TranslateTransform/>
                    </TransformGroup>
                  </FrameworkElement.LayoutTransform>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </dxnav:TileBarItem>
        <dxnav:TileBarItem Click="EqualsClick">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Style="{StaticResource FilterCount}"
                           Text="{Binding DataContext.EqualsCount, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource FilterText}" Text="{Localize Equals}"/>
                <TextBlock Text="=" Style="{StaticResource FilterInitials}"/>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </dxnav:TileBarItem>
        <dxnav:TileBarItem Click="DeficitsClick">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Style="{StaticResource FilterCount}"
                           Text="{Binding DataContext.DeficitCount, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource FilterText}" Text="{Localize Deficits}"/>
                <TextBlock Text="-" Style="{StaticResource FilterInitials}"/>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </dxnav:TileBarItem>
        <dxnav:TileBarItem Click="AllRecordsClick">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Style="{StaticResource FilterCount}"
                           Text="{Binding DataContext.AllRecordsCount, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource FilterText}" Text="{Localize 'All Records'}"/>
                <TextBlock Text="..." Style="{StaticResource FilterInitials}"/>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </dxnav:TileBarItem>
      </dxnav:TileBar>
      <dxlc:LayoutControl Margin="10,0,0,10" Grid.Row="1">
        <dxlc:LayoutGroup View="Tabs">
          <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize Options}">
            <dxlc:LayoutItem Label="{Localize 'Show Totals In'}">
              <dxg:LookUpEdit AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                              EditValue="{Binding DisplayCurrencyId, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Currencies.List}">
                <dxe:PopupBaseEdit.PopupContentTemplate>
                  <ControlTemplate>
                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                      <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Name"/>
                      </dxg:GridControl.Columns>
                      <dxg:GridControl.View>
                        <dxg:TableView AutoWidth="true"/>
                      </dxg:GridControl.View>
                    </dxg:GridControl>
                  </ControlTemplate>
                </dxe:PopupBaseEdit.PopupContentTemplate>
              </dxg:LookUpEdit>
            </dxlc:LayoutItem>
          </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
    </Grid>
    <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
    <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                            FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                            SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
      <dxg:GridControl.Bands>
        <dxg:GridControlBand Header="{Localize Stock}">
          <dxg:GridColumn FieldName="StockCode" Header="{Localize Code}"/>
          <dxg:GridColumn FieldName="StockName" Width="700" Header="{Localize Name}"/>
          <dxg:GridColumn FieldName="StockUnit" Width="60" Header="{Localize Unit}"/>
          <dxg:GridColumn FieldName="StockPrice" Style="{StaticResource AmountDisplayFormat}" Width="80"
                          Header="{Localize Price}"/>
          <dxg:GridColumn FieldName="StockPriceCurrencyId" Width="80" Header="{Localize Currency}">
            <dxg:ColumnBase.EditSettings>
              <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
            </dxg:ColumnBase.EditSettings>
          </dxg:GridColumn>
        </dxg:GridControlBand>
        <dxg:GridControlBand Header="{Localize Totals}">
          <dxg:GridColumn FieldName="TotalCounted" Style="{StaticResource QuantityDisplayFormat}" Header="{Localize Counted}"/>
          <dxg:GridColumn FieldName="TotalComputed" Style="{StaticResource QuantityDisplayFormat}"
                          Header="{Localize Computed}"/>
          <dxg:GridColumn FieldName="TotalDifference" Style="{StaticResource QuantityDisplayFormat}"
                          Header="{Localize Difference}"/>
          <dxg:GridColumn FieldName="DisplayTotal" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Total}"/>
        </dxg:GridControlBand>
      </dxg:GridControl.Bands>
      <dxg:GridControl.TotalSummary>
        <dxg:GridSummaryItem FieldName="StockCode" DisplayFormat="{0}" SummaryType="Count"/>
        <dxg:GridSummaryItem FieldName="TotalCounted" DisplayFormat="#,##0.##" SummaryType="Sum"/>
        <dxg:GridSummaryItem FieldName="TotalComputed" DisplayFormat="#,##0.##" SummaryType="Sum"/>
        <dxg:GridSummaryItem FieldName="TotalDifference" DisplayFormat="#,##0.##" SummaryType="Sum"/>
        <dxg:GridSummaryItem FieldName="DisplayTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
      </dxg:GridControl.TotalSummary>
    </ctrl:StyledGridControl>
  </DockPanel>
</mvx:MvxWpfView>