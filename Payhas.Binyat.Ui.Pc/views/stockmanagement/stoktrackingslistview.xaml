<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.StockManagement.StokTrackingsListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:ctrl="clr-namespace:Payhas.Binyat.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Payhas.Binyat.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.StockManagement;assembly=Payhas.Binyat.Ui.Core">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <dxlc:LayoutControl Margin="0" Orientation="Vertical">
      <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                              FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                              SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
        <dxg:GridControl.Bands>
          <dxg:GridControlBand Header="{Localize Stock}">
            <dxg:GridColumn FieldName="StockCode" Header="{Localize Code}"/>
            <dxg:GridColumn FieldName="StockName" Width="300" Header="{Localize Name}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize 'Action Quantities Tacking'}">
            <dxg:GridColumn FieldName="WarehouseId" Width="200" Header="{Localize Warehouse}">
              <dxg:ColumnBase.EditSettings>
                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Warehouses.List}"/>
              </dxg:ColumnBase.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="Income" Width="80" Header="{Localize Income}"/>
            <dxg:GridColumn FieldName="Expense" Width="80" Header="{Localize Expense}"/>
            <dxg:GridColumn FieldName="Left" Width="80" Header="{Localize Left}"/>
          </dxg:GridControlBand>
        </dxg:GridControl.Bands>
      </ctrl:StyledGridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>