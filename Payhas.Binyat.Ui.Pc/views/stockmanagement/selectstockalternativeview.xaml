<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.StockManagement.SelectStockAlternativeView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.StockManagement;assembly=Payhas.Binyat.Ui.Core">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal"
                dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button IsDefault="true" Content="{Localize Update}" Command="{Binding SelectCommand}"/>
      <Button IsCancel="true" Margin="10,0,0,0" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
    </StackPanel>
    <dxg:GridControl MaxHeight="550" MinHeight="300" MaxWidth="700" AutoExpandAllGroups="true"
                     ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem}">
      <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand PassEventArgsToCommand="True" EventName="MouseDoubleClick" Command="{Binding SelectCommand}"/>
      </dxmvvm:Interaction.Behaviors>
      <dxg:GridControl.Columns>
        <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
        <dxg:GridColumn FieldName="Name" Width="300" Header="{Localize Name}"/>
        <dxg:GridColumn FieldName="Price" Header="{Localize Price}"/>
        <dxg:GridColumn FieldName="CurrencyId" Header="{Localize Currency}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="Balance" Header="{Localize Balance}"/>
        <dxg:GridColumn FieldName="Unit" Header="{Localize Unit}"/>
      </dxg:GridControl.Columns>
      <dxg:GridControl.View>
        <dxg:TableView AutoWidth="true" AllowEditing="false" NavigationStyle="Row" ShowGroupPanel="false"
                       AllowLeaveFocusOnTab="true">
          <dxg:TableView.FormatConditions>
            <dxg:FormatCondition FieldName="IsDisabled" Expression="[IsDisabled]=True" ApplyToRow="true"
                                 PredefinedFormatName="LightRedFillWithDarkRedText"/>
            <dxg:FormatCondition FieldName="IsDisabled" Expression="[IsDisabled]=True" ApplyToRow="true"
                                 PredefinedFormatName="StrikethroughText"/>
          </dxg:TableView.FormatConditions>
        </dxg:TableView>
      </dxg:GridControl.View>
    </dxg:GridControl>
  </DockPanel>
</mvx:MvxWpfView>