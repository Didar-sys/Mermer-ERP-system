<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.StockManagement.StockRepriceDialogView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:sys="clr-namespace:System;assembly=mscorlib"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.StockManagement;assembly=Payhas.Binyat.Ui.Core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button HorizontalAlignment="Left" Content="{Localize 'Delete Selected'}"
              Command="{Binding SelectedItemsDeleteCommand}"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button IsDefault="true" Content="{Localize Reprice}" Command="{Binding RepriceCommand}"/>
        <Button IsCancel="true" Margin="10,0,0,0" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
      </StackPanel>
    </Grid>
    <dxlc:LayoutControl Orientation="Vertical" IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
      <dxlc:LayoutGroup Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
        <dxlc:LayoutItem Label="{Localize 'Reprice pecentage'}">
          <dxe:SpinEdit Width="100" MinValue="-100" EditValueType="{x:Type sys:Int32}" IsFloatValue="false"
                        EditValue="{Binding RepricePercentage, UpdateSourceTrigger=PropertyChanged}"/>
        </dxlc:LayoutItem>
        <Button Content="{Localize Calulate}" Command="{Binding CalculateNewPriceCommand}"/>
      </dxlc:LayoutGroup>
      <dxg:GridControl SelectionMode="MultipleRow" ItemsSource="{Binding List}" ShowLoadingPanel="{Binding IsBusy}">
        <dxg:DataControlBase.SelectedItems>
          <Binding>            <!-- constructor argument:
                 SelectedItems
            -->

          </Binding>
        </dxg:DataControlBase.SelectedItems>
        <dxg:GridControl.Bands>
          <dxg:GridControlBand Header="{Localize Stock}">
            <dxg:GridColumn FieldName="Stock.Code" AllowEditing="False" Header="{Localize Code}"/>
            <dxg:GridColumn FieldName="Stock.Name" Width="700" AllowEditing="False" Header="{Localize Name}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Current}">
            <dxg:GridColumn FieldName="CurrentPrice" Style="{StaticResource AmountDisplayFormat}" AllowEditing="False"
                            Header="{Localize Price}"/>
            <dxg:GridColumn FieldName="CurrentPriceCurrencyId" AllowEditing="False" Header="{Localize Currency}">
              <dxg:ColumnBase.EditSettings>
                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
              </dxg:ColumnBase.EditSettings>
            </dxg:GridColumn>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Reference}">
            <dxg:GridColumn FieldName="ReferencePrice" Style="{StaticResource AmountDisplayFormat}" AllowEditing="False"
                            Header="{Localize Price}"/>
            <dxg:GridColumn FieldName="ReferencePriceCurrencyId" AllowEditing="False" Header="{Localize Currency}">
              <dxg:ColumnBase.EditSettings>
                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
              </dxg:ColumnBase.EditSettings>
            </dxg:GridColumn>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize New}">
            <dxg:GridColumn FieldName="Stock.Price" Style="{StaticResource AmountDisplayFormat}" Header="{Localize Price}"/>
            <dxg:GridColumn FieldName="Stock.CurrencyId" Header="{Localize Currency}">
              <dxg:ColumnBase.EditSettings>
                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" AutoPopulateColumns="false"
                                        ItemsSource="{Binding Currencies.List}">
                  <dxe:PopupBaseEditSettings.PopupContentTemplate>
                    <ControlTemplate>
                      <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                        <dxg:GridControl.Columns>
                          <dxg:GridColumn FieldName="Name" SortOrder="Ascending"/>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                          <dxg:TableView AutoWidth="true"/>
                        </dxg:GridControl.View>
                      </dxg:GridControl>
                    </ControlTemplate>
                  </dxe:PopupBaseEditSettings.PopupContentTemplate>
                </dxg:LookUpEditSettings>
              </dxg:ColumnBase.EditSettings>
            </dxg:GridColumn>
          </dxg:GridControlBand>
        </dxg:GridControl.Bands>
        <dxg:GridControl.View>
          <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="None" AllowPerPixelScrolling="true"
                         ShowCheckBoxSelectorColumn="true" ShowCheckBoxSelectorInGroupRow="true"
                         RetainSelectionOnClickOutsideCheckBoxSelector="true">
            <dxg:TableView.FormatConditions>
              <dxg:FormatCondition FieldName="IsExceed" Expression="[IsExceed]=True" ApplyToRow="true"
                                   PredefinedFormatName="YellowFillWithDarkYellowText"/>
              <dxg:FormatCondition FieldName="IsDeficit" Expression="[IsDeficit]=True" ApplyToRow="true"
                                   PredefinedFormatName="LightRedFillWithDarkRedText"/>
            </dxg:TableView.FormatConditions>
          </dxg:TableView>
        </dxg:GridControl.View>
      </dxg:GridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>