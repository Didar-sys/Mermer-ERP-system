<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Common.DataImportView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Common;assembly=Payhas.Binyat.Ui.Core"
                Loaded="MvxWpfView_Loaded">
  <DockPanel>
    <Grid DockPanel.Dock="Top">
      <dxlc:LayoutControl Orientation="Vertical" MinHeight="10" MinWidth="400"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutItem Label="{Localize 'Select File'}">
          <dxe:ButtonEdit x:Name="FileName" AllowDefaultButton="False"
                          EditValue="{Binding FileName, UpdateSourceTrigger=PropertyChanged}">
            <dxe:ButtonInfo Click="ButtonInfo_Click" GlyphKind="Regular"/>
          </dxe:ButtonEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Height="15"/>
        <dxlc:LayoutGroup x:Name="Properties" Orientation="Vertical" IsEnabled="{Binding IsFileLoaded}"/>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom"
                VerticalAlignment="Top" dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button IsDefault="true" Content="{Localize Import}" Command="{Binding ImportCommand}"/>
      <Button IsCancel="true" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
    </StackPanel>
  </DockPanel>
</mvx:MvxWpfView>