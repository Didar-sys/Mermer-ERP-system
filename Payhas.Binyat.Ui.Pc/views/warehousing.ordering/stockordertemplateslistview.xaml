<mvx:MvxWpfView x:Class="Payhas.Binyat.Ui.Pc.Views.Warehousing.Ordering.StockOrderTemplatesListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Payhas.Binyat.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Payhas.Binyat.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Payhas.Binyat.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Payhas.Binyat.Ui.Core.ViewModels.Warehousing;assembly=Payhas.Binyat.Ui.Core">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:ListCreateNew/>
      <menu:ListViewDetails/>
      <dxwui:AppBarSeparator/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <ctrl:ListFilterTileControl DockPanel.Dock="Left"
                                Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
    <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                            FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                            SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
      <dxg:GridControl.Columns>
        <dxg:GridColumn FieldName="Name" SortOrder="Ascending" Width="300" Header="{Localize Name}"/>
        <dxg:GridColumn FieldName="IsDisabled" Width="70" Header="{Localize Deleted}"/>
        <dxg:GridColumn Binding="{Binding Tags, Converter={cnv:TokenConverter}}" Header="{Localize Tags}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings>
              <BaseEditSettings.StyleSettings>
                <dxg:TokenLookUpEditStyleSettings/>
              </BaseEditSettings.StyleSettings>
            </dxg:LookUpEditSettings>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="Group" GroupIndex="0" Header="{Localize Group}"/>
      </dxg:GridControl.Columns>
    </ctrl:StyledGridControl>
  </DockPanel>
</mvx:MvxWpfView>