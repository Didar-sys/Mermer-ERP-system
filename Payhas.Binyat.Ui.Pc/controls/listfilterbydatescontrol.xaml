<UserControl x:Class="Payhas.Binyat.Ui.Pc.Controls.ListFilterByDatesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
  <dxlc:LayoutControl Margin="10,0,0,10">
    <dxlc:LayoutGroup View="Tabs">
      <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Filter By Date'}">
        <dxlc:LayoutItem Label="{Localize From}">
          <dxe:DateEdit EditValue="{Binding DateFilterFrom, UpdateSourceTrigger=PropertyChanged}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="{Localize Till}">
          <dxe:DateEdit EditValue="{Binding DateFilterTill, UpdateSourceTrigger=PropertyChanged}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem>
          <Button Height="25" Content="{Localize Apply}" Command="{Binding FilterByDateCommand}"/>
        </dxlc:LayoutItem>
      </dxlc:LayoutGroup>
    </dxlc:LayoutGroup>
  </dxlc:LayoutControl>
</UserControl>