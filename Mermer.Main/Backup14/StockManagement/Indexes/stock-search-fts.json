{
 "name": "stock-search",
 "type": "fulltext-index",
 "params": {
  "doc_config": {
   "mode": "type_field",
   "type_field": "docType"
  },
  "mapping": {
   "default_analyzer": "standard",
   "default_datetime_parser": "dateTimeOptional",
   "default_field": "_all",
   "default_mapping": {
    "dynamic": true,
    "enabled": false
   },
   "default_type": "_default",
   "index_dynamic": true,
   "store_dynamic": false,
   "types": {
    "Stock": {
     "dynamic": false,
     "enabled": true,
     "properties": {
      "barcodes": {
       "enabled": true,
       "dynamic": false,
       "fields": [
        {
         "analyzer": "",
         "include_in_all": true,
         "include_term_vectors": true,
         "index": true,
         "name": "Barcodes",
         "store": true,
         "type": "text"
        }
       ]
      },
      "code": {
       "enabled": true,
       "dynamic": false,
       "fields": [
        {
         "analyzer": "",
         "include_in_all": true,
         "include_term_vectors": true,
         "index": true,
         "name": "Code",
         "store": true,
         "type": "text"
        }
       ]
      },
      "name": {
       "enabled": true,
       "dynamic": false,
       "fields": [
        {
         "analyzer": "",
         "include_in_all": true,
         "include_term_vectors": true,
         "index": true,
         "name": "Name",
         "store": true,
         "type": "text"
        }
       ]
      },
      "shortName": {
       "enabled": true,
       "dynamic": false,
       "fields": [
        {
         "analyzer": "",
         "include_in_all": true,
         "include_term_vectors": true,
         "index": true,
         "name": "ShortName",
         "store": true,
         "type": "text"
        }
       ]
      },
      "tags": {
       "enabled": true,
       "dynamic": false,
       "fields": [
        {
         "analyzer": "",
         "include_in_all": true,
         "include_term_vectors": true,
         "index": true,
         "name": "Tags",
         "store": true,
         "type": "text"
        }
       ]
      }
     }
    }
   }
  },
  "store": {
   "kvStoreName": "mossStore"
  }
 },
 "sourceType": "couchbase",
 "sourceName": "$sourceName$",
 "sourceUUID": "$sourceUUID$",
 "sourceParams": {},
 "planParams": {
  "maxPartitionsPerPIndex": 171,
  "numReplicas": 0
 }
}