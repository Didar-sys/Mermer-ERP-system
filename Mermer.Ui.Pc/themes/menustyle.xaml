<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui">
  <Style x:Key="MenuStyle" TargetType="{x:Type dxwui:AppBar}">
    <Setter Property="Control.Background" Value="{StaticResource appBarBackgroundBrush}"/>
    <Setter Property="dxwui:AppBar.HideMode" Value="AlwaysVisible"/>
    <Setter Property="dxwui:AppBar.IsCompact" Value="false"/>
  </Style>
</ResourceDictionary>