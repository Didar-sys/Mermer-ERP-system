<dxwui:AppBarButton x:Class="Mermer.Ui.Pc.Controls.MenuItems.ListCreateNew"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:hlp="clr-namespace:Mermer.Ui.Pc.Helpers"
                    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                    hlp:ShortcutExtender.Shortcut="Ctrl+N" Style="{StaticResource AppBarButtonBaseStyle}"
                    Label="{Localize New}" Command="{Binding CreateNewCommand}"
                    Glyph="{dx:DXImageGrayscale Image=New_32x32.png}"
                    Visibility="{Binding HasCreateAccess, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>