<dxg:GridSearchControl x:Class="Mermer.Ui.Pc.Controls.StyledGridSearchControl"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                       xmlns:hlp="clr-namespace:Mermer.Ui.Pc.Helpers"
                       xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                       xmlns:themes="http://schemas.devexpress.com/winfx/2008/xaml/editors/themekeys"
                       Margin="20" VerticalAlignment="Top" HorizontalAlignment="left"
                       hlp:ShortcutExtender.FocusShortcut="F3"
                       IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}"
                       Style="{DynamicResource {themes:SearchControlThemeKey ThemeName=HybridApp, ResourceKey=StandaloneStyle}}"/>