<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Reporting.RevenueReportView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Reporting;assembly=Mermer.Ui.Core"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <DockPanel>

        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}" Background="#595959" Foreground="White">
            <Border VerticalAlignment="Stretch" Margin="10,0,0,0">
                <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}" 
                                              NullText="{Localize Search}" 
                                              Width="215" 
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <menu:CommonReload/>
            <menu:ListPrint x:Name="PrintButton"/>
            <menu:ListFilter x:Name="FilterButton"/>
            <menu:CommonClose/>
        </dxwui:AppBar>

        <Border DockPanel.Dock="Left" Width="200" BorderThickness="0,0,0,0"
                Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}">

            <!-- Ліва панель -->
            <dxlc:LayoutControl DockPanel.Dock="Left" Orientation="Vertical" Width="200" Margin="5" Padding="10,10,15,10" 
                            VerticalAlignment="Top" ItemSpace="12"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}">

                <StackPanel>
                    <TextBlock Text="{Localize Warehouses}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:ComboBoxEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                                  ShowCustomItems="True" DisplayMember="Name" ValueMember="Id"
                                  EditValue="{Binding SelectedWarehouseIds, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Warehouses.List}">
                        <dxe:BaseEdit.StyleSettings>
                            <dxe:CheckedComboBoxStyleSettings/>
                        </dxe:BaseEdit.StyleSettings>
                    </dxe:ComboBoxEdit>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Localize From}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:DateEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                              EditValue="{Binding DateFilterFrom, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Localize Till}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:DateEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                              EditValue="{Binding DateFilterTill, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Button Height="26" Padding="0" Content="{Localize Load}" Command="{Binding ReloadCommand}" Margin="0,5,0,0"/>

            </dxlc:LayoutControl>
        </Border>

        <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>

        <dx:PLinqInstantFeedbackDataSource Name="ParalelLinqInstantSource" ItemsSource="{Binding List}"/>

        <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                            FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                            SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}"
                            ItemsSource="{Binding ElementName=ParalelLinqInstantSource, Path=Data}">
            <dxg:GridControl.Bands>
                <dxg:GridControlBand Header="{Localize Stock}">
                    <dxg:GridColumn FieldName="StockCode" Header="{Localize Code}"/>
                    <dxg:GridColumn FieldName="StockName" Width="400" Header="{Localize Name}"/>
                    <dxg:GridColumn Visible="false" Binding="{Binding StockTags, Converter={cnv:TokenConverter}}"
                          Header="{Localize Tags}">
                        <dxg:ColumnBase.EditSettings>
                            <dxg:LookUpEditSettings>
                                <dxe:BaseEditSettings.StyleSettings>
                                    <dxg:TokenLookUpEditStyleSettings/>
                                </dxe:BaseEditSettings.StyleSettings>
                            </dxg:LookUpEditSettings>
                        </dxg:ColumnBase.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="StockGroup" Visible="false" Header="{Localize Group}"/>
                    <dxg:GridColumn FieldName="StockType" Visible="false" Header="{Localize Type}"/>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="{Localize Action}">
                    <dxg:GridColumn FieldName="Date" SortOrder="Ascending" Header="{Localize Date}">
                        <dxg:ColumnBase.EditSettings>
                            <dxe:DateEditSettings DisplayFormat="g"/>
                        </dxg:ColumnBase.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="WarehouseId" Header="{Localize Warehouse}">
                        <dxg:ColumnBase.EditSettings>
                            <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Warehouses.List}"/>
                        </dxg:ColumnBase.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="Quantity" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                          Header="{Localize Quantity}"/>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="{Localize Costs}">
                    <dxg:GridColumn FieldName="InitialCosts" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Initial}"/>
                    <dxg:GridColumn FieldName="OverheadsCosts" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Overheads}"/>
                    <dxg:GridColumn FieldName="CostsTotal" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Total}"/>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="{Localize Recommended}">
                    <dxg:GridColumn FieldName="RecommendedPrice" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Price}"/>
                    <dxg:GridColumn FieldName="RecommendedTotal" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Total}"/>
                    <dxg:GridColumn FieldName="RecommendedEarning" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Earning}"/>
                </dxg:GridControlBand>
                <dxg:GridControlBand Header="{Localize Actual}">
                    <dxg:GridColumn FieldName="ActualPrice" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Price}"/>
                    <dxg:GridColumn FieldName="ActualTotal" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Total}"/>
                    <dxg:GridColumn FieldName="ActualEarning" Width="80" Style="{StaticResource AmountDisplayFormat}"
                          Header="{Localize Earning}"/>
                </dxg:GridControlBand>
            </dxg:GridControl.Bands>
            <dxg:GridControl.TotalSummary>
                <dxg:GridSummaryItem FieldName="StockCode" DisplayFormat="{}{0}" SummaryType="Count"/>
                <dxg:GridSummaryItem FieldName="InitialCosts" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="OverheadsCosts" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="CostsTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="RecommendedTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="RecommendedEarning" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="ActualTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                <dxg:GridSummaryItem FieldName="ActualEarning" DisplayFormat="#,##0.00" SummaryType="Sum"/>
            </dxg:GridControl.TotalSummary>
        </ctrl:StyledGridControl>
    </DockPanel>
</mvx:MvxWpfView>