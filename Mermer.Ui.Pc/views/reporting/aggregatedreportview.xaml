<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Reporting.AggregatedReportView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxnav="http://schemas.devexpress.com/winfx/2008/xaml/navigation"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Reporting;assembly=Mermer.Ui.Core">
  <FrameworkElement.Resources>
    <Style x:Key="Tile" TargetType="{x:Type dxlc:LayoutGroup}">
      <Setter Property="Panel.Background" Value="#FF2F51A5"/>
      <Setter Property="FrameworkElement.MaxHeight" Value="80"/>
    </Style>
    <Style x:Key="TileBorder" TargetType="{x:Type Border}">
      <Setter Property="Border.BorderBrush" Value="#FFD6D6D6"/>
      <Setter Property="Border.BorderThickness" Value="1"/>
      <Setter Property="Border.Padding" Value="5"/>
    </Style>
    <Style x:Key="TileWaterMark" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="80"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Left"/>
      <Setter Property="FrameworkElement.VerticalAlignment" Value="Top"/>
      <Setter Property="FrameworkElement.Margin" Value="6,-22,0,0"/>
      <Setter Property="UIElement.Opacity" Value="0.1"/>
    </Style>
    <Style x:Key="TileLabelSmall" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="10"/>
      <Setter Property="FrameworkElement.Margin" Value="0,0,0,-4"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center"/>
      <Setter Property="TextBlock.FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="TileLabelBig" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="12"/>
      <Setter Property="FrameworkElement.Margin" Value="0,0,0,-6"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center"/>
      <Setter Property="TextBlock.FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="TileValueSmall" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="20"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="TileValueBig" TargetType="{x:Type TextBlock}">
      <Setter Property="TextBlock.FontSize" Value="24"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
    </Style>
  </FrameworkElement.Resources>
  <DockPanel>

        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}" Background="#595959">
      <menu:CommonReload/>
      <menu:DetailsPrint/>
      <menu:CommonClose/>
    </dxwui:AppBar>

        <Border DockPanel.Dock="Left" Width="200" Background="Transparent" BorderThickness="0,0,0,0"
Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}">

            <dxlc:LayoutControl Orientation="Vertical" Margin="5" Padding="10,10,15,10" 
                    VerticalAlignment="Top" ItemSpace="12"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden">

                <StackPanel>
                    <TextBlock Text="{Localize Offices}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:ComboBoxEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                          ShowCustomItems="True" DisplayMember="Name" ValueMember="Id"
                          EditValue="{Binding SelectedOfficeIds, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Offices.List}">
                        <dxe:BaseEdit.StyleSettings>
                            <dxe:CheckedComboBoxStyleSettings/>
                        </dxe:BaseEdit.StyleSettings>
                    </dxe:ComboBoxEdit>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Localize From}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:DateEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                      EditValue="{Binding DateFilterFrom, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="{Localize Till}" Foreground="#FF2F51A5" FontSize="14" Margin="2,0,0,4"/>
                    <dxe:DateEdit Height="26" Padding="2,0,2,0" VerticalContentAlignment="Center"
                      EditValue="{Binding DateFilterTill, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Button Height="26" Padding="0" Content="{Localize Load}" Command="{Binding ReloadCommand}" Margin="0,5,0,0"/>

            </dxlc:LayoutControl>
        </Border>

        <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                      IsChecked="True" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
        <dxlc:LayoutControl Margin="0" Background="Transparent" Padding="10">
            <dxlc:LayoutGroup Orientation="Horizontal">

                <dxlc:LayoutGroup View="Tabs" Orientation="Horizontal" Margin="0,0,10,0">
                    <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Stocks Report'}" Background="White">
                        <ctrl:StyledGridControl Margin="0" ItemsSource="{Binding Report.StocksReport.Lines}">
                            <dxg:GridColumn FieldName="Type" Header="{Localize Type}">
                                <dxg:ColumnBase.EditSettings>
                                    <dxg:LookUpEditSettings DisplayMember="Text" ValueMember="Value" ItemsSource="{Binding Types.List}"/>
                                </dxg:ColumnBase.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Income" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Income}"/>
                            <dxg:GridColumn FieldName="Expense" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Expense}"/>
                            <dxg:GridColumn FieldName="Effect" Style="{StaticResource AmountDisplayFormat}" Width="70" Header="{Localize Effect}"/>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="Income" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Expense" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Effect" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                            </dxg:GridControl.TotalSummary>
                        </ctrl:StyledGridControl>

                        <dxlc:LayoutGroup Style="{StaticResource Tile}">
                            <Border Style="{StaticResource TileBorder}">
                                <Grid>
                                    <TextBlock Style="{StaticResource TileWaterMark}" Text="{Localize 'Stocks Report'}"/>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize STARTING}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.StocksReport.StartingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize EFFECTED}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.StocksReport.EffectedBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource TileLabelBig}" Text="{Localize RESULTING}"/>
                                        <TextBlock Style="{StaticResource TileValueBig}" Text="{Binding Report.StocksReport.ResultingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup View="Tabs" Orientation="Horizontal" Margin="0,0,10,0">
                    <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Funds Report'}" Background="White">
                        <ctrl:StyledGridControl Margin="0" ItemsSource="{Binding Report.FundsReport.Lines}">
                            <dxg:GridColumn FieldName="Type" Header="{Localize Type}">
                                <dxg:ColumnBase.EditSettings>
                                    <dxg:LookUpEditSettings DisplayMember="Text" ValueMember="Value" ItemsSource="{Binding Types.List}"/>
                                </dxg:ColumnBase.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Income" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Income}"/>
                            <dxg:GridColumn FieldName="Expense" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Expense}"/>
                            <dxg:GridColumn FieldName="Effect" Style="{StaticResource AmountDisplayFormat}" Width="70" Header="{Localize Effect}"/>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="Income" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Expense" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Effect" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                            </dxg:GridControl.TotalSummary>
                        </ctrl:StyledGridControl>

                        <dxlc:LayoutGroup Style="{StaticResource Tile}">
                            <Border Style="{StaticResource TileBorder}">
                                <Grid>
                                    <TextBlock Style="{StaticResource TileWaterMark}" Text="{Localize 'Funds Report'}"/>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize STARTING}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.FundsReport.StartingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize EFFECTED}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.FundsReport.EffectedBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource TileLabelBig}" Text="{Localize RESULTING}"/>
                                        <TextBlock Style="{StaticResource TileValueBig}" Text="{Binding Report.FundsReport.ResultingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup View="Tabs" Orientation="Horizontal" Margin="0">
                    <dxlc:LayoutGroup Orientation="Vertical" Header="{Localize 'Partners Report'}" Background="White">
                        <ctrl:StyledGridControl Margin="0" ItemsSource="{Binding Report.PartnersReport.Lines}">
                            <dxg:GridColumn FieldName="Type" Header="{Localize Type}">
                                <dxg:ColumnBase.EditSettings>
                                    <dxg:LookUpEditSettings DisplayMember="Text" ValueMember="Value" ItemsSource="{Binding Types.List}"/>
                                </dxg:ColumnBase.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="Debit" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Debit}"/>
                            <dxg:GridColumn FieldName="Credit" Style="{StaticResource AmountDisplayFormat}" Width="60" Header="{Localize Credit}"/>
                            <dxg:GridColumn FieldName="Effect" Style="{StaticResource AmountDisplayFormat}" Width="70" Header="{Localize Effect}"/>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="Debit" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Credit" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                                <dxg:GridSummaryItem FieldName="Effect" DisplayFormat="#,##0.00" SummaryType="Sum"/>
                            </dxg:GridControl.TotalSummary>
                        </ctrl:StyledGridControl>

                        <dxlc:LayoutGroup Style="{StaticResource Tile}">
                            <Border Style="{StaticResource TileBorder}">
                                <Grid>
                                    <TextBlock Style="{StaticResource TileWaterMark}" Text="{Localize 'Partners Report'}"/>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize STARTING}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.PartnersReport.StartingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource TileLabelSmall}" Text="{Localize EFFECTED}"/>
                                        <TextBlock Style="{StaticResource TileValueSmall}" Text="{Binding Report.PartnersReport.EffectedBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource TileLabelBig}" Text="{Localize RESULTING}"/>
                                        <TextBlock Style="{StaticResource TileValueBig}" Text="{Binding Report.PartnersReport.ResultingBalance, Converter={cnv:DecimalToStringConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </dxlc:LayoutGroup>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </DockPanel>
</mvx:MvxWpfView>