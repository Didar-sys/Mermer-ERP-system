<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Warehousing.Revisioning.StockRevisionDetailsUncountedView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Warehousing.Revisioning;assembly=Mermer.Ui.Core">
  <DockPanel>
    <Grid DockPanel.Dock="Bottom" dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button HorizontalAlignment="Left" Content="{Localize 'Delete Selected'}"
              Command="{Binding SelectedItemsDeleteCommand}"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button IsDefault="true" Content="{Localize 'Add To Revision'}" Command="{Binding AddToRevisionCommand}"/>
        <Button IsCancel="true" Margin="10,0,0,0" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
      </StackPanel>
    </Grid>
    <dxg:GridControl SelectionMode="MultipleRow" ItemsSource="{Binding List}" ShowLoadingPanel="{Binding IsBusy}">
      <dxg:DataControlBase.SelectedItems>
        <Binding>          <!-- constructor argument:
               SelectedItems
          -->

        </Binding>
      </dxg:DataControlBase.SelectedItems>
      <dxg:GridControl.Bands>
        <dxg:GridControlBand Header="{Localize Stock}">
          <dxg:GridColumn FieldName="StockCode" AllowEditing="False" Header="{Localize Code}"/>
          <dxg:GridColumn FieldName="StockName" Width="700" AllowEditing="False" Header="{Localize Name}"/>
        </dxg:GridControlBand>
        <dxg:GridControlBand Header="{Localize 'Current Count'}">
          <dxg:GridColumn FieldName="Counted" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                          Header="{Localize Qnt}"/>
          <dxg:GridColumn FieldName="StockUnit" Width="80" AllowEditing="False" Header="{Localize Unit}"/>
        </dxg:GridControlBand>
        <dxg:GridControlBand Header="{Localize 'Total Counts'}">
          <dxg:GridColumn FieldName="Computed" Style="{StaticResource QuantityDisplayFormat}" AllowEditing="False"
                          Header="{Localize Computed}"/>
          <dxg:GridColumn FieldName="Difference" Style="{StaticResource QuantityDisplayFormat}" AllowEditing="False"
                          Header="{Localize Difference}"/>
        </dxg:GridControlBand>
      </dxg:GridControl.Bands>
      <dxg:GridControl.View>
        <dxg:TableView AutoWidth="true" ShowGroupPanel="false" NewItemRowPosition="None" AllowPerPixelScrolling="true"
                       ShowCheckBoxSelectorColumn="true" ShowCheckBoxSelectorInGroupRow="true"
                       RetainSelectionOnClickOutsideCheckBoxSelector="true">
          <dxg:TableView.FormatConditions>
            <dxg:FormatCondition FieldName="IsExceed" Expression="[IsExceed]=True" ApplyToRow="true"
                                 PredefinedFormatName="YellowFillWithDarkYellowText"/>
            <dxg:FormatCondition FieldName="IsDeficit" Expression="[IsDeficit]=True" ApplyToRow="true"
                                 PredefinedFormatName="LightRedFillWithDarkRedText"/>
          </dxg:TableView.FormatConditions>
        </dxg:TableView>
      </dxg:GridControl.View>
    </dxg:GridControl>
  </DockPanel>
</mvx:MvxWpfView>