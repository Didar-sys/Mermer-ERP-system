<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Commerce.InvoicePaymentDialogView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Commerce;assembly=Mermer.Ui.Core">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal"
                dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
      <Button IsDefault="true" Content="{Localize Update}" Command="{Binding UpdateCommand}"/>
      <Button IsCancel="true" Margin="10,0,0,0" Content="{Localize Cancel}" Command="{Binding CloseCommand}"/>
    </StackPanel>
    <Grid FocusManager.FocusedElement="{Binding ElementName=FirstFocus}">
      <dxlc:LayoutControl Width="300" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"
                          IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutItem Label="{Localize Total}">
          <dxe:SpinEdit IsReadOnly="true" AllowDefaultButton="False" Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.SubTotal, Mode=OneWay}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="{Localize Discount}">
          <dxe:SpinEdit Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.DiscountsTotal, UpdateSourceTrigger=PropertyChanged}">
            <dxe:ButtonInfo GlyphKind="Apply" Command="{Binding RoundingDiscountCommand}"/>
          </dxe:SpinEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Label="{Localize GrandTotal}">
          <dxe:SpinEdit IsReadOnly="true" AllowDefaultButton="False" Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.GrandTotal, Mode=OneWay}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Height="10"/>
        <dxlc:LayoutItem PreviewKeyDown="Payments_OnKeyDown" Label="{Localize Payments}">
          <dxe:SpinEdit x:Name="FirstFocus" MinValue="0" Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.PaymentsTotal, UpdateSourceTrigger=PropertyChanged}">
            <dxe:ButtonInfo GlyphKind="Apply" Command="{Binding FillPaymentCommand}"/>
          </dxe:SpinEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem PreviewKeyDown="Changes_OnKeyDown" Label="{Localize Changes}">
          <dxe:SpinEdit MinValue="0" Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.ChangesTotal, UpdateSourceTrigger=PropertyChanged}">
            <dxe:ButtonInfo GlyphKind="Apply" Command="{Binding FillChangesCommand}"/>
          </dxe:SpinEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Height="10"/>
        <dxlc:LayoutItem Label="{Localize Left}">
          <dxe:SpinEdit IsReadOnly="true" AllowDefaultButton="False" Mask="###,###,##0.00" MaskUseAsDisplayFormat="true"
                        EditValue="{Binding Details.LeftTotal, Mode=OneWay}"/>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem Visibility="{Binding Details.CanDebitCredit, Converter={dxmvvm:BooleanToVisibilityConverter}}">
          <dxe:CheckEdit Content="{Localize 'Debit/Credit Left Amount'}"
                         EditValue="{Binding Details.DebitCreditLeftAmount, UpdateSourceTrigger=PropertyChanged}"/>
        </dxlc:LayoutItem>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>