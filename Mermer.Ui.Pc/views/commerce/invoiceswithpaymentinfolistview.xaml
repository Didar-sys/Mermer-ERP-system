<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.Commerce.InvoicesWithPaymentInfoListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.Commerce;assembly=Mermer.Ui.Core">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <ctrl:ListFilterControl DockPanel.Dock="Left"
                            Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
    <dxlc:LayoutControl Margin="0" Orientation="Vertical">
      <dxlc:LayoutGroup Orientation="Vertical" Margin="10, 10, 10, 0">
        <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize Office}">
          <dxg:LookUpEdit NullValueButtonPlacement="EditBox" AutoPopulateColumns="false" DisplayMember="Name"
                          ValueMember="Id" EditValue="{Binding OfficeId, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Offices.List}" NullText="{Localize 'All Offices'}">
            <dxe:PopupBaseEdit.PopupContentTemplate>
              <ControlTemplate>
                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                  <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Name"/>
                  </dxg:GridControl.Columns>
                  <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="true"/>
                  </dxg:GridControl.View>
                </dxg:GridControl>
              </ControlTemplate>
            </dxe:PopupBaseEdit.PopupContentTemplate>
            <dxg:LookUpEdit.StyleSettings>
              <dxg:SearchLookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
          </dxg:LookUpEdit>
        </dxlc:LayoutItem>
        <dxlc:LayoutItem HorizontalAlignment="Left" Width="400" Label="{Localize Partner}">
          <dxg:LookUpEdit NullValueButtonPlacement="EditBox" AutoPopulateColumns="false" DisplayMember="Fullname"
                          ValueMember="Id" EditValue="{Binding PartnerId, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Partners.List}" NullText="{Localize 'All Partners'}">
            <dxe:PopupBaseEdit.PopupContentTemplate>
              <ControlTemplate>
                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                  <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
                    <dxg:GridColumn FieldName="Name" Width="300" Header="{Localize Name}"/>
                  </dxg:GridControl.Columns>
                  <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="true"/>
                  </dxg:GridControl.View>
                </dxg:GridControl>
              </ControlTemplate>
            </dxe:PopupBaseEdit.PopupContentTemplate>
            <dxg:LookUpEdit.StyleSettings>
              <dxg:SearchLookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
          </dxg:LookUpEdit>
        </dxlc:LayoutItem>
      </dxlc:LayoutGroup>
      <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                              FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                              SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
        <dxg:GridColumn FieldName="Date" SortOrder="Ascending" Header="{Localize Date}">
          <dxg:ColumnBase.EditSettings>
            <dxe:DateEditSettings DisplayFormat="g"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="Code" Header="{Localize Code}"/>
        <dxg:GridColumn FieldName="PartnerId" Width="300" Header="{Localize Partner}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings DisplayMember="Fullname" ValueMember="Id" ItemsSource="{Binding Partners.List}"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="OfficeId" Header="{Localize Office}">
          <dxg:ColumnBase.EditSettings>
            <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Offices.List}"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="UserName" Width="80" Header="{Localize Author}"/>
        <dxg:GridColumn FieldName="IsPayed" Width="50" Header="{Localize Payed}"/>
        <dxg:GridColumn FieldName="IsOverDue" Width="50" Header="{Localize Overdue}"/>
        <dxg:GridColumn FieldName="Total" Style="{StaticResource AmountDisplayFormat}" Width="80" Header="{Localize Total}"/>
        <dxg:GridColumn FieldName="PaymentsTotal" Style="{StaticResource AmountDisplayFormat}" Width="80"
                        Header="{Localize Payed}"/>
        <dxg:GridColumn FieldName="LastPaymentDate" Width="90" Header="{Localize 'Last Payment Date'}">
          <dxg:ColumnBase.EditSettings>
            <dxe:DateEditSettings DisplayFormat="d"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridColumn FieldName="DueDate" Width="90" Header="{Localize 'Due Date'}">
          <dxg:ColumnBase.EditSettings>
            <dxe:DateEditSettings DisplayFormat="d"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
        <dxg:GridControl.TotalSummary>
          <dxg:GridSummaryItem FieldName="Date" DisplayFormat="{}{0}" SummaryType="Count"/>
          <dxg:GridSummaryItem FieldName="Total" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="PaymentsTotal" DisplayFormat="#,##0.00" SummaryType="Sum"/>
        </dxg:GridControl.TotalSummary>
      </ctrl:StyledGridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>