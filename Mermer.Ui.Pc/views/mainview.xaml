<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.MainView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:viewModels="clr-namespace:Mermer.Mvvm.ViewModels;assembly=Mermer.Mvvm"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">
    <FrameworkElement.Resources>
        <Style x:Key="HeaderCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="TextBlock.Foreground" Value="{StaticResource grayForegroundBrush}"/>
        </Style>
        <Style x:Key="HeaderSubCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="TextBlock.Foreground" Value="{StaticResource blueForegroundBrush}"/>
            <Setter Property="TextBlock.FontSize" Value="9"/>
        </Style>
        <Style x:Key="WelcomeMessage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeaderCaption}">
            <Setter Property="TextBlock.FontSize" Value="32"/>
            <Setter Property="TextBlock.Padding" Value="10"/>
            <Setter Property="FrameworkElement.VerticalAlignment" Value="Bottom"/>
            <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerMenuNavigationButton}">
            <Setter Property="dxwui:HamburgerMenuNavigationButton.AllowGlyphTheming" Value="true"/>
            <Setter Property="dxwui:HamburgerMenuNavigationButton.GlyphColor"
              Value="{Binding Foreground.Color, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerMenu}">
            <Setter Property="dxwui:HamburgerMenu.PaneBackground" Value="{StaticResource appBarBackgroundBrush}"/>
            <Setter Property="dxwui:HamburgerMenu.BottomBarBackground" Value="{StaticResource appBarBackgroundBrush}"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerSubMenu}">
            <Setter Property="dxwui:HamburgerSubMenu.MoreButtonVisibilityMode" Value="Hidden"/>
            <Setter Property="dxwui:HamburgerSubMenu.IsStandaloneSelectionItemMode" Value="true"/>
            <Setter Property="dxwui:HamburgerSubMenu.AllowGlyphTheming" Value="true"/>
            <Setter Property="dxwui:HamburgerSubMenu.GlyphColor"
              Value="{Binding Foreground.Color, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerSubMenuNavigationButton}">
        </Style>
        <Style x:Key="Group" TargetType="{x:Type dxwui:HamburgerSubMenuNavigationButton}">
            <Setter Property="UIElement.IsEnabled" Value="false"/>
            <Setter Property="Control.FontSize" Value="8"/>
            <Setter Property="FrameworkElement.Height" Value="8"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerMenuBottomBarNavigationButton}">
            <Setter Property="dxwui:HamburgerMenuBottomBarNavigationButton.AllowGlyphTheming" Value="true"/>
            <Setter Property="dxwui:HamburgerMenuBottomBarNavigationButton.GlyphColor"
              Value="{Binding Foreground.Color, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerMenuBottomBarCheckBox}">
            <Setter Property="dxwui:HamburgerMenuBottomBarCheckBox.AllowGlyphTheming" Value="true"/>
            <Setter Property="dxwui:HamburgerMenuBottomBarCheckBox.GlyphColor"
              Value="{Binding Foreground.Color, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </FrameworkElement.Resources>

    <dx:DXTabControl x:Name="TabControl" Padding="0" dx:ThemeManager.ThemeName="Office2013DarkGray;Touch">
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type dx:DXTabItem}">
                <Setter Property="Focusable" Value="false"/>

                <Setter Property="Header" Value="{Binding DataContext}"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="viewModels:BaseViewModel">
                            <StackPanel Orientation="Vertical" Focusable="false">
                                <TextBlock Style="{StaticResource HeaderCaption}" Text="{Binding Caption}"/>
                                <TextBlock Style="{StaticResource HeaderSubCaption}" Text="{Binding SubCaption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ItemsControl.ItemContainerStyle>
        <dx:DXTabControl.ControlBoxLeftTemplate>
            <DataTemplate>
                <Grid x:Name="TopPlaceHolder" Margin="47,0,10,0" Height="47">
                    <StackPanel Orientation="Vertical">
                        <Label Foreground="White" VerticalAlignment="Top" VerticalContentAlignment="Top" FontSize="16"
                   Margin="0,5,0,0" Padding="0" FontWeight="Bold" Content="{Localize Mermer}"/>
                        <Label Foreground="White" VerticalAlignment="Top" VerticalContentAlignment="Top"
                   HorizontalContentAlignment="Center" FontSize="12" Margin="0" Padding="0"
                   Content="{Binding CurrentUser}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </dx:DXTabControl.ControlBoxLeftTemplate>
        <dx:DXTabControl.ControlBoxRightTemplate>
            <DataTemplate>
                <Grid Width="10"/>
            </DataTemplate>
        </dx:DXTabControl.ControlBoxRightTemplate>
        <dx:DXTabControl.ContentHostTemplate>
            <DataTemplate>
                <dxwui:HamburgerMenu x:Name="Menu" HeaderHeight="47" Margin="-1,-47,0,-1"
                     HorizontalHeaderBackground="Transparent">

                    <dxwui:HamburgerMenu.Style>
                        <Style TargetType="dxwui:HamburgerMenu">
                            <Setter Property="ViewState" Value="Overlay"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoHideMenu}" Value="True">
                                    <Setter Property="ViewState" Value="Inline"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dxwui:HamburgerMenu.Style>

                    <dxwui:HamburgerMenu.Items>
                        <dxwui:HamburgerMenuNavigationButton Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/Actions/Buy_32x32.png"
                                             Content="{Localize Pos}" Command="{Binding ShowPosCommand}"/>
                        <dxwui:HamburgerMenuItemSeparator/>
                        <dxwui:HamburgerSubMenu Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/Sales/SalesAnalysis_32x32.png"
                                    Content="{Localize Commerce}" FlyoutHeader="{Localize Commerce}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Slips}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize Invoices}" Command="{Binding ShowInvoicesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize Bills}" Command="{Binding ShowBillsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Reports}"
                                                      Visibility="{Binding AllowReporting, Converter={dx:BooleanToVisibilityConverter}}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Sales Payment Info'}" Command="{Binding ShowInvoicePaymentDataCommand}"
                                                      Visibility="{Binding AllowReporting, Converter={dx:BooleanToVisibilityConverter}}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Sales}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Sales Invoice'}"
                                                      Command="{Binding ShowNewInvoiceCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Sales Return Invoice'}" Command="{Binding ShowNewInvoiceCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Funds Collection Bill'}" Command="{Binding ShowNewBillCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Procurement}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Purchase Invoice'}"
                                                      Command="{Binding ShowNewInvoiceCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Purchase Return Invoice'}" Command="{Binding ShowNewInvoiceCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'New Funds Payment Bill'}"
                                                      Command="{Binding ShowNewBillCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerSubMenu Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/View/Customers_32x32.png"
                                    Content="{Localize CRM}" FlyoutHeader="{Localize CRM}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Dictionaries}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize PartnersList}" Command="{Binding ShowPartnersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Slips}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Partner Slips'}" Command="{Binding ShowPartnerSlipsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Partner Balance Transfers'}"
                                                      Command="{Binding ShowPartnerBalanceTransfersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Reports}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Partner Actions List'}" Command="{Binding ShowPartnerActionsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Partner Balances List'}" Command="{Binding ShowPartnerBalancesCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerSubMenu Content="{Localize Finance}" FlyoutHeader="{Localize Finance}"
                                    Glyph="{dx:DXImageGrayscale Image=Currency_32x32.png}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Dictionaries}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize CurrenciesList}" Command="{Binding ShowCurrenciesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize ExpensesList}" Command="{Binding ShowExpensesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Slips}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Funds Slips'}" Command="{Binding ShowFundsSlipsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Funds Transfers'}" Command="{Binding ShowFundsTransfersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Funds Expenses'}" Command="{Binding ShowExpenseSlipsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Daily Funds Registeries'}" Command="{Binding ShowDailyFundsRegisteriesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Reports}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Funds Actions List'}" Command="{Binding ShowFundsActionsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Funds Balances List'}" Command="{Binding ShowFundsBalancesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Expense Actions List'}" Command="{Binding ShowExpenseActionsCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerSubMenu Content="{Localize Warehousing}" FlyoutHeader="{Localize Warehousing}"
                                    Glyph="{dx:DXImageOffice2013 Image=PackageProduct_32x32.png}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Dictionaries}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize StocksList}" Command="{Binding ShowStocksCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Slips}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Slips'}" Command="{Binding ShowStockSlipsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Transfers'}" Command="{Binding ShowStockTransfersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Reports}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Actions List'}" Command="{Binding ShowStockActionsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Balances List'}" Command="{Binding ShowStockBalancesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Revisioning}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Revisions'}" Command="{Binding ShowStockRevisionsCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Ordering}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Orders'}" Command="{Binding ShowStockOrdersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Order Templates'}" Command="{Binding ShowStockOrderTemplatesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Aggregated Orders'}" Command="{Binding ShowAggregatedStockOrdersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Additional}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Name Composers List'}" Command="{Binding ShowStockNameComposersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Alternatives List'}" Command="{Binding ShowStockAlternativesCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerSubMenu Content="{Localize Reports}" FlyoutHeader="{Localize Reports}"
                                    Glyph="{dx:DXImageOffice2013 Image=KnowledgeBaseArticle_32x32.png}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize 'Stock Report'}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Balances (By Statuses)'}"
                                                      Command="{Binding ShowStockBalancesByStatusesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Balances (By Warehouses)'}"
                                                      Command="{Binding ShowStockBalancesByWarehouseCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Turnover Data'}" Command="{Binding ShowStockTurnoverDataCommand}"
                                                      Visibility="{Binding AllowReporting, Converter={dx:BooleanToVisibilityConverter}}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Stock Reprice Effects'}" Command="{Binding ShowStockRepriceEffectsCommand}"
                                                      Visibility="{Binding AllowReporting, Converter={dx:BooleanToVisibilityConverter}}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize 'General Reports'}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Aggregated Report'}" Command="{Binding ShowAggregatedReportCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Revenue Report'}" Command="{Binding ShowRevenueReportCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerSubMenu Placement="Bottom"
                                    Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/Actions/ViewSetting_32x32.png"
                                    Content="{Localize Settings}" FlyoutHeader="{Localize Settings}">
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Enterprise}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize Offices}" Command="{Binding ShowOfficesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize StockAccounts}" Command="{Binding ShowWarehousesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize FundsAccounts}" Command="{Binding ShowDepositoriesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Authentication}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize Users}" Command="{Binding ShowUsersCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize UserRoles}" Command="{Binding ShowRolesCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Change Password'}" Command="{Binding ChangePasswordCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Configurations}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize ApplicationConfiguration}" Command="{Binding ShowAppConfigCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize PrinterConfiguration}" Command="{Binding ShowPrinterConfigCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize BarcodeConfiguration}" Command="{Binding ShowBarcodeConfigCommand}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize PrintLayoutConfiguration}"
                                        Visibility="{Binding IsAdmin, Converter={dx:BooleanToVisibilityConverter}}"
                                        Click="ShowPrintLayoutConfig"/>
                            <dxwui:HamburgerSubMenuNavigationButton Style="{StaticResource Group}" Content="{Localize Mocking}"
                                                      Visibility="{Binding IsInDebugMode, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Visibility="{Binding IsInDebugMode, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                                                      Content="{Localize MockObjectsCreator}" Command="{Binding ShowMockObjectsCreator}"/>
                            <dxwui:HamburgerSubMenuNavigationButton Content="{Localize 'Sync Data Fixer'}" Command="{Binding ShowSyncDataFixerCommand}"/>
                        </dxwui:HamburgerSubMenu>
                        <dxwui:HamburgerMenuNavigationButton Placement="Bottom"
                                                 Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/Actions/About_32x32.png"
                                                 Command="{Binding ShowAboutCommand}" Content="{Localize 'About Application'}"/>
                    </dxwui:HamburgerMenu.Items>
                    <dxwui:HamburgerMenu.BottomBarItems>
                        <dxwui:HamburgerMenuBottomBarCheckBox x:Name="AutoHideMenu" Visibility="Visible" Width="44" Placement="Left"
                                                        Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/Actions/HideProduct_32x32.png"
                                                        IsChecked="{Binding AutoHideMenu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        Content="{Localize 'Menu Always Visible'}"/>
                        <dxwui:HamburgerMenuBottomBarNavigationButton Placement="Left" Content="{Localize 'Check For Updates'}"
                                              Click="CheckUpdatesBtn_Click"
                                              Glyph="{dx:DXImageOffice2013 Image=Download_32x32.png}"/>
                        <dxwui:HamburgerMenuBottomBarNavigationButton Placement="Right" 
                                                          Glyph="pack://application:,,,/DevExpress.Images.v21.2;component/DevAV/People/Walking_32x32.png"
                                                          Content="{Localize Logout}" Command="{Binding LogoutCommand}"/>
                    </dxwui:HamburgerMenu.BottomBarItems>
                    <ContentControl.Content>
                        <Grid Margin="0">
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource HeaderCaption}" HorizontalAlignment="Right" Padding="0, 0, 10, 0"
                           Text="{Localize AppCreator, FallBackText='Mermer Creation Studio'}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource WelcomeMessage}" Text="{Localize Mermer}"/>
                                    <TextBlock Style="{StaticResource WelcomeMessage}"/>
                                </StackPanel>
                            </StackPanel>
                            <dx:ContentHost Margin="-1,0,-1,0" Child="{x:Null}"/>
                        </Grid>
                    </ContentControl.Content>
                </dxwui:HamburgerMenu>
            </DataTemplate>
        </dx:DXTabControl.ContentHostTemplate>
        <dx:DXTabControl.View>
            <dx:TabControlStretchView HideButtonShowMode="InActiveTab" />
        </dx:DXTabControl.View>
    </dx:DXTabControl>
</mvx:MvxWpfView>