<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockTurnoverDataListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:cnv="clr-namespace:Mermer.Ui.Pc.Converters"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <DockPanel>
        <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
            <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
            <menu:CommonReload/>
            <menu:ListPrint x:Name="PrintButton" IsEnabled="{DXBinding '@e(GridControl).VisibleRowCount != 0'}"/>
            <menu:ListFilter x:Name="FilterButton"/>
            <menu:CommonClose/>
        </dxwui:AppBar>
        <ctrl:ListFilterTileControl DockPanel.Dock="Left"
                                    Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
        <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                      IsChecked="True" VerticalAlignment="Center"/>
        <dxlc:LayoutControl Margin="0" Orientation="Vertical">
            <dxlc:LayoutGroup Orientation="Vertical" Margin="10, 10, 10, 0">
                <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize Warehouse}">
                    <dxg:LookUpEdit NullValueButtonPlacement="EditBox" AutoPopulateColumns="false" DisplayMember="Name"
                                    ValueMember="Id" EditValue="{Binding WarehouseId, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding Warehouses.List}">
                        <dxe:PopupBaseEdit.PopupContentTemplate>
                            <ControlTemplate>
                                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                                    <dxg:GridControl.Columns>
                                        <dxg:GridColumn FieldName="Name"/>
                                    </dxg:GridControl.Columns>
                                    <dxg:GridControl.View>
                                        <dxg:TableView AutoWidth="true"/>
                                    </dxg:GridControl.View>
                                </dxg:GridControl>
                            </ControlTemplate>
                        </dxe:PopupBaseEdit.PopupContentTemplate>
                        <dxg:LookUpEdit.StyleSettings>
                            <dxg:SearchLookUpEditStyleSettings/>
                        </dxg:LookUpEdit.StyleSettings>
                    </dxg:LookUpEdit>
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
            <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                                    FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                                    SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
                <dxg:GridControl.Bands>
                    <dxg:GridControlBand Header="{Localize Stock}">
                        <dxg:GridColumn FieldName="StockCode" SortOrder="Ascending" Header="{Localize Code}"/>
                        <dxg:GridColumn FieldName="StockName" SortOrder="Ascending" Width="300" Header="{Localize Name}"/>
                        <dxg:GridColumn FieldName="DisplayTags" Header="{Localize Tags}" Width="150" ReadOnly="True"/>
                        <dxg:GridColumn FieldName="StockGroup" GroupIndex="1" Header="{Localize Group}"/>
                        <dxg:GridColumn FieldName="StockType" GroupIndex="0" Header="{Localize Type}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Income}">
                        <dxg:GridColumn FieldName="WarehouseId" Header="{Localize Warehouse}">
                            <dxg:ColumnBase.EditSettings>
                                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Warehouses.List}"/>
                            </dxg:ColumnBase.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Income" Style="{StaticResource QuantityDisplayFormat}" Width="80"
                                        Header="{Localize Income}"/>
                        <dxg:GridColumn FieldName="Expense" Style="{StaticResource QuantityDisplayFormat}" Width="80"
                                        Header="{Localize Expense}"/>
                    </dxg:GridControlBand>
                    <dxg:GridControlBand Header="{Localize Sales}">
                        <dxg:GridColumn FieldName="Sellable" Style="{StaticResource QuantityDisplayFormat}" Width="80"
                                        Header="{Localize Sellable}"/>
                        <dxg:GridColumn FieldName="Sold" Style="{StaticResource QuantityDisplayFormat}" Width="80" Header="{Localize Sold}"/>
                        <dxg:GridColumn FieldName="Turnover" Style="{StaticResource QuantityDisplayFormat}" Width="80"
                                        Header="{Localize Turnover}"/>
                    </dxg:GridControlBand>
                </dxg:GridControl.Bands>
            </ctrl:StyledGridControl>
        </dxlc:LayoutControl>
    </DockPanel>
</mvx:MvxWpfView>