<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.StockManagement.StockBalancesByDateAndWarehousesListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:hlp="clr-namespace:Mermer.Ui.Pc.Helpers"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.StockManagement;assembly=Mermer.Ui.Core"
                PreviewKeyDown="DetectShortCut" dx:ThemeManager.ThemeName="HybridApp">
  <FrameworkElement.Resources>
    <DataTemplate x:Key="ColumnTemplate">
      <ContentControl>
        <dxg:GridColumn UnboundType="Decimal" Width="80" FieldName="{Binding PropertyName}" Header="{Binding DisplayName}">
          <dxg:ColumnBase.EditSettings>
            <dxe:TextEditSettings DisplayFormat="#,##0.##"/>
          </dxg:ColumnBase.EditSettings>
        </dxg:GridColumn>
      </ContentControl>
    </DataTemplate>
  </FrameworkElement.Resources>
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <dxwui:AppBarButton hlp:ShortcutExtender.Shortcut="Ctrl+Delete" Label="{Localize 'Delete Line'}"
                          Command="{Binding SelectedLineDeleteCommand}"
                          Visibility="{Binding IsItemSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"
                          Glyph="{dx:DXImageGrayscale Image=DeleteItem_32x32.png}"/>
      <dxwui:AppBarSeparator Visibility="{Binding IsItemSelected, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <Grid FocusManager.FocusedElement="{Binding ElementName=FirstFocus}">
      <dxlc:LayoutControl Margin="10" IsEnabled="{Binding IsBusy, Converter={dxmvvm:BooleanNegationConverter}}">
        <dxlc:LayoutGroup Orientation="Vertical">
          <dxlc:LayoutItem HorizontalAlignment="Left" Width="400" Label="{Localize 'Balance Date'}">
            <dxe:DateEdit Mask="D" MaskUseAsDisplayFormat="true"
                          EditValue="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
          </dxlc:LayoutItem>
          <dxlc:LayoutItem HorizontalAlignment="Left" Width="600" Label="{Localize Warehouses}">
            <dxe:ComboBoxEdit ShowCustomItems="True" DisplayMember="Name" ValueMember="Id"
                              EditValue="{Binding SelectedWarehouseIds, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Warehouses.List}">
              <dxe:BaseEdit.StyleSettings>
                <dxe:CheckedComboBoxStyleSettings/>
              </dxe:BaseEdit.StyleSettings>
            </dxe:ComboBoxEdit>
          </dxlc:LayoutItem>
          <dxlc:LayoutGroup>
            <dxlc:LayoutItem MaxWidth="730" Label="{Localize Add}">
              <dxlc:LayoutGroup>
                <ctrl:StockLookupEdit x:Name="FirstFocus" DataContext="{Binding StockSearcher}">
                  <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:FocusBehavior EventName="Loaded"/>
                  </dxmvvm:Interaction.Behaviors>
                </ctrl:StockLookupEdit>
              </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem>
              <Button HorizontalAlignment="Left" Height="34" Content="{Localize 'Add All Stocks'}"
                      Command="{Binding AddAllStocksCommand}"/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem HorizontalAlignment="Right" MinWidth="100">
              <dxg:LookUpEdit AutoPopulateColumns="false" DisplayMember="Name" ValueMember="Id"
                              EditValue="{Binding DisplayCurrencyId, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Currencies.List}">
                <dxe:PopupBaseEdit.PopupContentTemplate>
                  <ControlTemplate>
                    <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                      <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Name"/>
                      </dxg:GridControl.Columns>
                      <dxg:GridControl.View>
                        <dxg:TableView AutoWidth="true"/>
                      </dxg:GridControl.View>
                    </dxg:GridControl>
                  </ControlTemplate>
                </dxe:PopupBaseEdit.PopupContentTemplate>
              </dxg:LookUpEdit>
            </dxlc:LayoutItem>
          </dxlc:LayoutGroup>
          <ctrl:StyledGridControl x:Name="GridControl" CustomUnboundColumnData="GridControl_CustomUnboundColumnData" Margin="0"
                                  AutoWidth="false" ShowLoadingPanel="false" ShowTotalSummary="true" ShowGroupedColumns="false"
                                  PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                                  FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                                  SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
            <dxg:GridControl.Bands>
              <dxg:GridControlBand Fixed="Left" Header="{Localize Stock}">
                <dxg:GridColumn Style="{StaticResource GridRowNo}"/>
                <dxg:GridColumn FieldName="StockCode" SortOrder="Ascending" Width="80" Header="{Localize Code}"/>
                <dxg:GridColumn FieldName="StockName" Width="400" Header="{Localize Name}"/>
                <dxg:GridColumn FieldName="StockGroup" GroupIndex="1" Header="{Localize Group}"/>
                <dxg:GridColumn FieldName="StockType" GroupIndex="0" Header="{Localize Type}"/>
                <dxg:GridColumn FieldName="StockTags" Visible="false" Header="{Localize Tags}"/>
                <dxg:GridColumn FieldName="StockPrice" Style="{StaticResource AmountDisplayFormat}" Width="80"
                                Header="{Localize Price}"/>
                <dxg:GridColumn FieldName="StockPriceCurrencyId" Width="60" Header="{Localize Currency}">
                  <dxg:ColumnBase.EditSettings>
                    <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Currencies.List}"/>
                  </dxg:ColumnBase.EditSettings>
                </dxg:GridColumn>
              </dxg:GridControlBand>
              <dxg:GridControlBand ColumnGeneratorTemplate="{StaticResource ColumnTemplate}" Header="{Localize Balances}"
                                   ColumnsSource="{Binding Columns}"/>
              <dxg:GridControlBand Fixed="Right" Header="{Localize Totals}">
                <dxg:GridColumn FieldName="TotalBalance" Style="{StaticResource QuantityDisplayFormat}" Width="100"
                                Header="{Localize Balance}"/>
                <dxg:GridColumn FieldName="StockUnit" Width="80" Header="{Localize Unit}"/>
                <dxg:GridColumn FieldName="TotalAmount" Style="{StaticResource AmountDisplayFormat}" Width="100"
                                Header="{Localize Amount}"/>
              </dxg:GridControlBand>
            </dxg:GridControl.Bands>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem FieldName="TotalAmount" SummaryType="Sum" DisplayFormat="{}{0:#,###.00}"/>
                        </dxg:GridControl.TotalSummary>
          </ctrl:StyledGridControl>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
      <Grid Visibility="{Binding IsBusy, Converter={dxmvvm:BooleanToVisibilityConverter}}">
        <dx:WaitIndicator DeferedVisibility="{Binding IsBusy}"/>
      </Grid>
    </Grid>
  </DockPanel>
</mvx:MvxWpfView>