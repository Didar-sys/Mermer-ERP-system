<mvx:MvxWpfView x:Class="Mermer.Ui.Pc.Views.FundsManagement.FundsBalancesListView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                xmlns:mvx="clr-namespace:MvvmCross.Wpf.Views;assembly=MvvmCross.Wpf"
                xmlns:ctrl="clr-namespace:Mermer.Ui.Pc.Controls"
                xmlns:menu="clr-namespace:Mermer.Ui.Pc.Controls.MenuItems"
                xmlns:vm="clr-namespace:Mermer.Ui.Core.ViewModels.FundsManagement;assembly=Mermer.Ui.Core"
                xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
  <DockPanel>
    <dxwui:AppBar DockPanel.Dock="Bottom" Style="{StaticResource MenuStyle}">
      <ctrl:StyledGridSearchControl x:Name="SearchControl" View="{Binding View, ElementName=GridControl}"/>
      <menu:ShowActions/>
      <dxwui:AppBarSeparator/>
      <menu:CommonReload/>
      <menu:ListPrint x:Name="PrintButton"/>
      <menu:ListFilter x:Name="FilterButton"/>
      <menu:CommonClose/>
    </dxwui:AppBar>
    <ctrl:ListFilterControl DockPanel.Dock="Left"
                            Visibility="{Binding ElementName=ExpandButton, Path=IsChecked, Converter={dxmvvm:BooleanToVisibilityConverter}}"/>
    <ToggleButton x:Name="ExpandButton" DockPanel.Dock="Left" Style="{StaticResource HideButtonStyle}"
                  IsChecked="True" VerticalAlignment="Center"/>
    <dxlc:LayoutControl Margin="0" Orientation="Vertical">
      <dxlc:LayoutGroup Orientation="Vertical" Margin="10, 10, 10, 0">
        <dxlc:LayoutItem HorizontalAlignment="Left" Width="300" Label="{Localize Depository}">
          <dxg:LookUpEdit NullValueButtonPlacement="EditBox" AutoPopulateColumns="false" DisplayMember="Name"
                          ValueMember="Id" EditValue="{Binding DepositoryId, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Depositories.List}" NullText="{Localize 'All Depositories'}">
            <dxe:PopupBaseEdit.PopupContentTemplate>
              <ControlTemplate>
                <dxg:GridControl Name="PART_GridControl" AutoExpandAllGroups="true">
                  <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Name"/>
                  </dxg:GridControl.Columns>
                  <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="true"/>
                  </dxg:GridControl.View>
                </dxg:GridControl>
              </ControlTemplate>
            </dxe:PopupBaseEdit.PopupContentTemplate>
            <dxg:LookUpEdit.StyleSettings>
              <dxg:SearchLookUpEditStyleSettings/>
            </dxg:LookUpEdit.StyleSettings>
          </dxg:LookUpEdit>
        </dxlc:LayoutItem>
      </dxlc:LayoutGroup>
      <ctrl:StyledGridControl x:Name="GridControl" PrintButton="{Binding ElementName=PrintButton, Mode=OneWay}"
                              FilterButton="{Binding ElementName=FilterButton, Mode=OneWay}"
                              SearchControl="{Binding ElementName=SearchControl, Mode=OneWay}">
        <dxg:GridControl.Bands>
          <dxg:GridControlBand Header="{Localize Depository}">
            <dxg:GridColumn FieldName="DepositoryId" SortOrder="Ascending" AllowCellMerge="True" Header="{Localize Depository}">
              <dxg:ColumnBase.EditSettings>
                <dxg:LookUpEditSettings DisplayMember="Name" ValueMember="Id" ItemsSource="{Binding Depositories.List}"/>
              </dxg:ColumnBase.EditSettings>
            </dxg:GridColumn>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Starting}">
            <dxg:GridColumn FieldName="StartingBalance" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Balance}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Income}">
            <dxg:GridColumn FieldName="FundsOpening" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Opening}"/>
            <dxg:GridColumn FieldName="FundsRevisionExceed" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Rev. Exc.'}"/>
            <dxg:GridColumn FieldName="FundsTransferDestination" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Transfer Destination'}"/>
            <dxg:GridColumn FieldName="Sales" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Sales}"/>
            <dxg:GridColumn FieldName="PurchaseReturn" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Purchase Return'}"/>
            <dxg:GridColumn FieldName="Collection" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Collection}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Expense}">
            <dxg:GridColumn FieldName="FundsRevisionDeficit" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Rev. Def.'}"/>
            <dxg:GridColumn FieldName="FundsTransferSource" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Transfer Source'}"/>
            <dxg:GridColumn FieldName="ExpenseSlip" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Spending}"/>
            <dxg:GridColumn FieldName="SalesReturn" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize 'Sales Return'}"/>
            <dxg:GridColumn FieldName="Purchase" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Purchase}"/>
            <dxg:GridColumn FieldName="Payment" Width="80" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Payment}"/>
          </dxg:GridControlBand>
          <dxg:GridControlBand Header="{Localize Resulting}">
            <dxg:GridColumn FieldName="ResultingBalance" Style="{StaticResource QuantityDisplayFormat}"
                            Header="{Localize Balance}"/>
          </dxg:GridControlBand>
        </dxg:GridControl.Bands>
        <dxg:GridControl.TotalSummary>
          <dxg:GridSummaryItem FieldName="DepositoryId" DisplayFormat="{}{0}" SummaryType="Count"/>
          <dxg:GridSummaryItem FieldName="StartingBalance" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="FundsOpening" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="FundsRevisionExceed" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="FundsTransferSource" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="Sales" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="PurchaseReturn" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="Collection" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="FundsRevisionDeficit" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="FundsTransferDestination" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="ExpenseSlip" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="SalesReturn" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="Purchase" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="Payment" DisplayFormat="#,##0.00" SummaryType="Sum"/>
          <dxg:GridSummaryItem FieldName="ResultingBalance" DisplayFormat="#,##0.00" SummaryType="Sum"/>
        </dxg:GridControl.TotalSummary>
      </ctrl:StyledGridControl>
    </dxlc:LayoutControl>
  </DockPanel>
</mvx:MvxWpfView>